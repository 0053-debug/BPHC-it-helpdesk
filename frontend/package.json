{
  "name": "iitsm-frontend",
  "private": true,
  "description": "I-ITSM campus IT service management client",
  "author": "BITS Pilani Hyderabad Campus",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs --dev\"",
    "electron:dist": "npm run build && electron-builder --publish never",
    "electron:win": "npm run build && electron-builder --win nsis --publish never",
    "electron:mac": "npm run build && electron-builder --mac dmg --publish never",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@emailjs/browser": "^5.0.3",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/host-grotesk": "^5.3.0",
    "@stomp/stompjs": "^7.0.0",
    "axios": "^1.7.7",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "sockjs-client": "^1.6.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^7.0.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true,
    "protobufjs@7.6.6": true
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "edu.bphc.iitsm",
    "productName": "I-ITSM",
    "directories": {
      "output": "release"
    },
    "disableAsarIntegrity": true,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "artifactName": "I-ITSM-${os}-${arch}-${version}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "public/app-icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
